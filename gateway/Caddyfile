# Gateway: única puerta de entrada a los servicios. Recibe todas las peticiones y las
# reparte según el inicio de la ruta. En B4 este mismo Caddy dará HTTPS automático.
{
	# Sin HTTPS por ahora (se activa en B4, con el dominio) y sin API de administración.
	auto_https off
	admin off
}

:8080 {
	# Un cuerpo de más de 1 MB se rechaza con 413 antes de llegar a los servicios.
	request_body {
		max_size 1MB
	}

	# handle_path quita el prefijo: /auth/health llega al servicio como /health.
	handle_path /auth/* {
		reverse_proxy auth:8000
	}

	# Salud del propio gateway.
	handle /health {
		header Content-Type application/json
		respond `{"status":"ok"}` 200
	}

	handle {
		respond 404
	}

	header -Server
}
