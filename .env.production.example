# .env de producción: vive solo en la VM (/srv/finance-balance/.env, permisos 600). Nunca en git.
# deploy/preparar-vm.sh lo crea con claves aleatorias generadas en la propia VM; este archivo solo
# documenta qué contiene.

APP_ENV=production

# Dominio de la API. Con un dominio aquí, Caddy activa HTTPS solo.
SITE_ADDRESS=api.risteyra.com

POSTGRES_USER=finance
POSTGRES_PASSWORD=se-genera-en-la-vm
POSTGRES_DB=finance_balance

# Mínimo 32 caracteres. Cambiarlo cierra todas las sesiones abiertas.
JWT_SECRET=se-genera-en-la-vm

# IMAGE_TAG no va aquí: el despliegue lo pasa en cada ejecución (el commit que se despliega).
