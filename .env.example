# Copia este archivo a .env y completa los valores. Nunca subas .env al repositorio.
APP_ENV=development

POSTGRES_USER=finance
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=finance_balance

# Firma los tokens de acceso del servicio de autenticación. Mínimo 32 caracteres.
# Genera uno propio con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambia-esto-cambia-esto-cambia-esto-cambia-esto-

# La usa la API cuando se corre fuera de Docker.
DATABASE_URL=postgresql+psycopg://finance:cambia-esta-clave@localhost:5432/finance_balance
